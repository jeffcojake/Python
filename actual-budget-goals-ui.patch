+import { Trans } from 'react-i18next';
+
+import {
+  currentMonth,
+  differenceInCalendarMonths,
+  format as formatMonth,
+} from 'loot-core/shared/months';
+import type { ByTemplate } from 'loot-core/types/models/templates';
+import type { TransObjectLiteral } from 'loot-core/types/util';
+
+import { FinancialText } from '@desktop-client/components/FinancialText';
+import { useFormat } from '@desktop-client/hooks/useFormat';
+
+type ByDateAutomationReadOnlyProps = {
+  template: ByTemplate;
+};
+
+export const ByDateAutomationReadOnly = ({
+  template,
+}: ByDateAutomationReadOnlyProps) => {
+  const format = useFormat();
+
+  const monthsLeft = Math.max(
+    1,
+    differenceInCalendarMonths(template.month, currentMonth()),
+  );
+  const monthlyAmount = Math.ceil(template.amount / monthsLeft);
+  const targetMonth = formatMonth(template.month, 'MMMM yyyy');
+
+  return (
+    <Trans>
+      Save{' '}
+      <FinancialText>
+        {
+          {
+            amount: format(template.amount, 'financial'),
+          } as TransObjectLiteral
+        }
+      </FinancialText>{' '}
+      by {{ targetMonth }} (
+      <FinancialText>
+        {
+          {
+            monthly: format(monthlyAmount, 'financial'),
+          } as TransObjectLiteral
+        }
+      </FinancialText>
+      /mo)
+    </Trans>
+  );
+};
