@@ -0,0 +1,58 @@
+import { Trans } from 'react-i18next';
+
+import { Text } from '@actual-app/components/text';
+import { theme } from '@actual-app/components/theme';
+import { View } from '@actual-app/components/view';
+
+import { useEnvelopeSheetValue } from '@desktop-client/components/budget/envelope/EnvelopeBudgetComponents';
+import { envelopeBudget } from '@desktop-client/spreadsheet/bindings';
+
+type GoalProgressBarProps = {
+  categoryId: string;
+};
+
+export function GoalProgressBar({ categoryId }: GoalProgressBarProps) {
+  const budgeted =
+    useEnvelopeSheetValue(envelopeBudget.catBudgeted(categoryId)) ?? 0;
+  const goal = useEnvelopeSheetValue(envelopeBudget.catGoal(categoryId)) ?? 0;
+
+  if (!goal || goal === 0) {
+    return null;
+  }
+
+  const pct = Math.min(budgeted / goal, 1);
+  const fillColor =
+    pct >= 1
+      ? theme.noticeText
+      : pct >= 0.5
+        ? theme.warningText
+        : theme.errorText;
+
+  return (
+    <View style={{ gap: 4 }}>
+      <View
+        style={{
+          height: 6,
+          borderRadius: 3,
+          backgroundColor: theme.tableBorder,
+          overflow: 'hidden',
+        }}
+      >
+        <View
+          style={{
+            width: `${Math.round(pct * 100)}%`,
+            height: '100%',
+            backgroundColor: fillColor,
+            borderRadius: 3,
+            transition: 'width 0.2s ease',
+          }}
+        />
+      </View>
+      <Text style={{ fontSize: 11, color: theme.tableTextLight }}>
+        <Trans>
+          {{ pct: Math.round(pct * 100) }}% of monthly target funded
+        </Trans>
+      </Text>
+    </View>
+  );
+}
